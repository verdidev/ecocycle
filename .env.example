# =============================================================================
# EcoCycle - variaveis de ambiente
# Copie para .env e preencha:   cp .env.example .env
# O arquivo .env NUNCA deve ser versionado (ja esta no .gitignore).
# =============================================================================

# --- Aplicacao ---------------------------------------------------------------
# Porta publicada no host (dentro do container a aplicacao sempre usa 8080)
APP_PORT=8080
# Nome do ambiente exibido em /actuator/info (local, staging, production)
APP_ENVIRONMENT=local
# Imagem usada pelo Compose. Local: deixe o padrao (build do codigo-fonte).
# Servidor: ghcr.io/<usuario-github>/ecocycle:sha-<commit>
APP_IMAGE=ecocycle-api:local
# Opcoes da JVM
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
# true para logar SQL (apenas para depuracao)
JPA_SHOW_SQL=false

# --- Usuario da API (Spring Security / Basic Auth) ---------------------------
APP_SECURITY_USERNAME=admin
APP_SECURITY_PASSWORD=troque-esta-senha

# --- Banco Oracle (container gvenzl/oracle-free) -----------------------------
# Senha dos usuarios administrativos SYS/SYSTEM do container Oracle
ORACLE_PASSWORD=troque-esta-senha-admin
# Usuario/schema da aplicacao (criado automaticamente pelo container na 1a subida)
DB_USERNAME=ecocycle
DB_PASSWORD=troque-esta-senha-db
# URL JDBC. No Compose o host e o NOME DO SERVICO (oracle-db), nunca localhost.
# Fora do Docker (ex.: mvn spring-boot:run) use jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_URL=jdbc:oracle:thin:@//oracle-db:1521/FREEPDB1
# So use true para adotar um schema legado que ja tenha as tabelas
FLYWAY_BASELINE_ON_MIGRATE=false
